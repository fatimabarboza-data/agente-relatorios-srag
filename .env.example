# Copie este arquivo para .env e preencha a chave. O .env nunca é versionado.

# Provedor do LLM: "github" (GitHub Models), "groq", "google" ou "openai".
# Se ficar em branco, o projeto usa o primeiro provedor que tiver chave abaixo.
LLM_PROVEDOR=github

# Modelo (opcional). Padrões: openai/gpt-4.1-mini (github), openai/gpt-oss-120b (groq),
# gemini-flash-latest (google), gpt-4o-mini (openai)
# LLM_MODELO=

# Chave do provedor escolhido
# GitHub Models: token pessoal com permissão "Models: read" (https://github.com/settings/personal-access-tokens)
GITHUB_TOKEN=
# GROQ_API_KEY=      # https://console.groq.com/keys
# GOOGLE_API_KEY=    # https://aistudio.google.com/app/apikey
# OPENAI_API_KEY=    # https://platform.openai.com/api-keys
