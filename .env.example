# Copie este arquivo para .env e preencha a chave. O .env nunca é versionado.

# Provedor do LLM: "google" (padrão, tem plano gratuito) ou "openai"
LLM_PROVEDOR=google

# Modelo (opcional). Padrões: gemini-flash-latest (google) / gpt-4o-mini (openai)
# LLM_MODELO=gemini-flash-latest

# Chave do provedor escolhido (crie em https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=
# OPENAI_API_KEY=
